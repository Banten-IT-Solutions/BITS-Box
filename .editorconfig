root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts}]
indent_size = 4
ij_kotlin_code_style = official
ij_kotlin_imports_layout = *

[*.{java}]
indent_size = 4

[*.{xml}]
indent_size = 2

[*.{gradle,gradle.kts}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{md,json,yml,yaml}]
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4
