<?xml version="1.0" encoding="utf-8"?>
<!-- Night variants: primary lightens to tone 300 (pops on dark surfaces),
     onPrimary darkens to tone 900 (readable on light primary).
     colorPrimaryDark stays tone 700 so the status bar stays dark with white icons. -->
<resources>

    <!-- Base theme - night -->
    <style name="Theme.BITSBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/material_blue_300</item>
        <item name="colorPrimaryDark">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorMaterial100">@color/material_blue_grey_900</item>
        <item name="colorMaterial300">@color/material_blue_grey_500</item>

        <item name="accentOrTextSecondary">?colorSecondary</item>
        <item name="accentOrTextPrimary">?colorSecondary</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorOnPrimary</item>
        <item name="whiteOrTextPrimary">?colorOnPrimary</item>
        <item name="mainIconText">@color/black</item>
        <item name="ContentIconText">@color/white</item>

        <!-- Global switch style: force thumb/track to theme colors (see values/themes.xml) -->
        <item name="switchStyle">@style/Widget.BITSBox.CompoundButton.Switch</item>
        <item name="android:switchStyle">@style/Widget.BITSBox.CompoundButton.Switch</item>

        <item name="actionBarTheme">@style/ThemeOverlay.BITSBox.Dark.ActionBar</item>
        <item name="popupMenuStyle">@style/Widget.BITSBox.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.BITSBox.PopupMenu.Overflow</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.BITSBox.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.BITSBox.PopupMenu</item>
        <item name="listMenuViewStyle">@style/Widget.BITSBox.ListMenuView</item>
        <item name="colorControlNormal">?attr/mainIconText</item>
        <item name="colorControlActivated">?attr/mainIconText</item>
        <item name="android:colorControlNormal">?attr/mainIconText</item>
        <item name="android:colorControlActivated">?attr/mainIconText</item>
        <item name="spinnerStyle">@style/Widget.BITSBox.Spinner</item>
        <item name="android:dropDownListViewStyle">@style/Widget.BITSBox.DropDownListView</item>
        <item name="android:popupBackground">@drawable/bg_popup_window</item>
        <item name="android:popupAnimationStyle">@anim/bitsbox_popup_enter</item>
        <item name="preferenceTheme">@style/PreferenceTheme.BITSBox</item>
    </style>

    <!-- Preference screens: icons + text use ContentIconText for surface contrast -->
    <!-- Parent Theme.BITSBox so ?attr/ContentIconText resolves; carry BasePreferenceThemeOverlay items -->
    <style name="PreferenceTheme.BITSBox" parent="Theme.BITSBox">
        <item name="checkBoxPreferenceStyle">@style/Preference.CheckBoxPreference.Material</item>
        <item name="dialogPreferenceStyle">@style/Preference.DialogPreference.Material</item>
        <item name="dropdownPreferenceStyle">@style/Preference.DropDown.BITSBox</item>
        <item name="editTextPreferenceStyle">@style/Preference.DialogPreference.EditTextPreference.BITSBox</item>
        <item name="preferenceCategoryStyle">@style/Preference.Category.Material</item>
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Material</item>
        <item name="preferenceFragmentListStyle">@style/PreferenceFragmentList.Material</item>
        <item name="preferenceFragmentStyle">@style/PreferenceFragment.Material</item>
        <item name="preferenceScreenStyle">@style/Preference.PreferenceScreen.Material</item>
        <item name="preferenceStyle">@style/Preference.Material</item>
        <item name="seekBarPreferenceStyle">@style/Preference.SeekBarPreference.Material</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.SwitchPreferenceCompat.BITSBox</item>
        <item name="switchPreferenceStyle">@style/Preference.SwitchPreference.Material</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.AppCompat.Body2</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
        <item name="ContentIconText">@color/white</item>
        <item name="android:textColorPrimary">?attr/ContentIconText</item>
        <item name="android:textColorSecondary">?attr/ContentIconText</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="colorOnSecondary">?attr/colorPrimary</item>
        <item name="colorSecondaryContainer">?attr/mainIconText</item>
        <item name="colorOnSecondaryContainer">?attr/ContentIconText</item>
    </style>

    <!-- Custom switch style: thumb/track use ColorStateList selectors -->
    <style name="Preference.SwitchPreferenceCompat.BITSBox" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

