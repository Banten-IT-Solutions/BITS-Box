    </style>

    <style name="Widget.BITSBox.DropDownListView" parent="Widget.AppCompat.ListView">
        <item name="android:background">@drawable/bg_dropdown_popup</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <!-- No horizontal padding: items are measured at full width by
             Spinner.measureContentWidth, so any list padding would clip the
             widest item (e.g. "HTTP Upgrade" -> "HTTP Upg..."). Items already
             carry their own 16dp start/end padding. -->
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <!-- Items are full-width with opaque square backgrounds (SimpleMenuAdapter
             colors each row), so without clipping they poke out past the 16dp
             rounded corners of bg_dropdown_popup and the dropdown corners look
             square / show an extra box. On API 31+ the whole list is clipped to
             the rounded background outline (see values-v31) so rows are cut
             cleanly at the corners. -->
        <item name="android:outlineProvider">background</item>
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@drawable/bg_popup_menu</item>
        <item name="android:cacheColorHint">?attr/colorPrimary</item>
        <item name="android:scrollingCache">false</item>
        <item name="android:animationCache">false</item>
    </style>

