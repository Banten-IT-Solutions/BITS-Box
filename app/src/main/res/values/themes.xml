        <item name="android:popupElevation">0dp</item>
        <item name="android:windowBackground">@drawable/bg_popup_menu</item>
    </style>

    <!-- App bar overflow: drops down from the toolbar, so only the bottom
         corners are rounded (square top edge connects to the app bar). -->
    <style name="Widget.BITSBox.PopupMenu.Overflow" parent="Widget.BITSBox.PopupMenu">
        <item name="android:dropDownHorizontalOffset">-8dp</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:popupBackground">@drawable/bg_popup_window_bottom_rounded</item>
        <item name="android:windowBackground">@drawable/bg_popup_menu_bottom_rounded</item>
    </style>

    <!-- App bar submenu dropdowns (anchored to the toolbar, e.g. manual
         settings / order menus): only bottom corners rounded. -->
    <style name="Widget.BITSBox.PopupMenu.AppBar" parent="Widget.BITSBox.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_window_bottom_rounded</item>
        <item name="android:windowBackground">@drawable/bg_popup_menu_bottom_rounded</item>
    </style>

    <!-- Bottom nav "More": pops up from the bottom navigation bar, so only
         the top corners are rounded (square bottom edge connects to the bar).
         No vertical offset: the popup bottom must sit flush against the bar. -->
    <style name="Widget.BITSBox.PopupMenu.More" parent="Widget.BITSBox.PopupMenu">
        <item name="android:dropDownHorizontalOffset">-8dp</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
        <item name="android:popupBackground">@drawable/bg_popup_window_top_rounded</item>
        <item name="android:windowBackground">@drawable/bg_popup_menu_top_rounded</item>
    </style>

    <!-- Share: nudge left only -->
    <style name="Widget.BITSBox.PopupMenu.Share" parent="Widget.BITSBox.PopupMenu">
        <item name="android:dropDownHorizontalOffset">-8dp</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
    </style>

