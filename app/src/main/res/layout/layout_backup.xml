<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/layout_appbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Reset settings -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reset_settings"
                tools:ignore="UnusedIds"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_import_contacts_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:text="@string/reset_settings"
                app:cornerRadius="8dp" />

            <!-- Backup content selection -->
            <com.google.android.material.card.MaterialCardView
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <CheckBox
                        android:id="@+id/backup_configurations"
                        tools:ignore="UnusedIds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/backup_groups_and_configurations"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <CheckBox
                        android:id="@+id/backup_rules"
                        tools:ignore="UnusedIds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:layout_marginTop="8dp"
                        android:text="@string/backup_rules"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <CheckBox
                        android:id="@+id/backup_settings"
                        tools:ignore="UnusedIds"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:layout_marginTop="8dp"
                        android:text="@string/backup_settings"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_summary"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:textColorSecondary" />

            <!-- Export / Share actions -->
            <LinearLayout
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_export"
                    tools:ignore="UnusedIds"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:icon="@drawable/ic_baseline_rule_folder_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:text="@string/action_export"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/action_share"
                    tools:ignore="UnusedIds"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:icon="@drawable/ic_social_share"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:text="@string/share"
                    app:cornerRadius="8dp" />

            </LinearLayout>

            <!-- Import -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/action_import_file"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_baseline_import_contacts_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:text="@string/action_import_file"
                app:cornerRadius="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
