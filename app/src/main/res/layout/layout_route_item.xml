<?xml version="1.0" encoding="utf-8"?>
<!-- Route Item with Material Design 3 styling -->
<!-- Pattern: Name + chips (left) → Switch + action buttons (right), all in one compact row -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="1dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_lin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Left section: rule name + chips -->
        <LinearLayout
            android:id="@+id/name_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/action_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Rule name - bold, primary -->
            <TextView
                android:id="@+id/rule_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/ContentIconText"
                android:textStyle="bold"
                tools:text="Block Ads" />

            <!-- Match criteria chip row 1 -->
            <LinearLayout
                android:id="@+id/info_chips_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/type_chip"
                    style="@style/Widget.Material3.Chip.Assist.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:minWidth="24dp"
                    android:paddingHorizontal="4dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/ContentIconText"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipIconTint="?attr/ContentIconText"
                    app:chipMinHeight="20dp"
                    app:chipStrokeColor="?attr/ContentIconText"
                    app:chipStrokeWidth="0.5dp"
                    app:closeIconVisible="false"
                    tools:text="DOMAIN" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/outbound_chip"
                    style="@style/Widget.Material3.Chip.Assist.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:minWidth="24dp"
                    android:paddingHorizontal="4dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/ContentIconText"
                    android:textSize="11sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipIconTint="?attr/ContentIconText"
                    app:chipMinHeight="20dp"
                    app:chipStrokeColor="?attr/ContentIconText"
                    app:chipStrokeWidth="0.5dp"
                    app:closeIconVisible="false"
                    tools:text="PROXY" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right section: switch + action buttons (inline) -->
        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBaseline_toBaselineOf="@id/name_row"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Enable toggle switch (Material 3 Switch) -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/enable_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:clickable="true" />

            <!-- Edit button -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/edit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit"
                android:padding="4dp"
                app:srcCompat="@drawable/ic_image_edit"
                app:tint="?attr/ContentIconText" />

            <!-- Delete button -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/delete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:padding="4dp"
                app:srcCompat="@drawable/baseline_delete_sweep_24"
                app:tint="?attr/ContentIconText" />
        </LinearLayout>

        <!-- Matched apps/apps count info row (optional, below main row) -->
        <TextView
            android:id="@+id/apps_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/ContentIconText"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/match_count"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name_row"
            tools:text="Matched: 12 apps"
            tools:visibility="visible" />

        <!-- Matched count badge -->
        <TextView
            android:id="@+id/match_count"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/badge_circle"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/ContentIconText"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/apps_info"
            app:layout_constraintEnd_toStartOf="@id/action_row"
            app:layout_constraintTop_toBottomOf="@id/name_row"
            tools:text="12"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
