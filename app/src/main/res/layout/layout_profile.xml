<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_selected_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Profile name -->
        <TextView
            android:id="@+id/profile_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:nextFocusRight="@+id/edit"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/card_name_text"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/edit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/profile_name" />

        <!-- Edit button -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit"
            android:focusable="true"
            android:padding="4dp"
            app:layout_constraintEnd_toStartOf="@id/share"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_image_edit" />

        <!-- Share button -->
        <LinearLayout
            android:id="@+id/share"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:focusable="true"
            app:layout_constraintEnd_toStartOf="@id/remove"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/share_layer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="4dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/shareIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_social_share" />
            </LinearLayout>
        </LinearLayout>

        <!-- Delete button -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/remove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:focusable="true"
            android:padding="4dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_action_delete" />

        <!-- Chips row left: Type + Status (vertically locked to chip_row_right
             so both bands stay symmetric regardless of name text metrics) -->
        <LinearLayout
            android:id="@+id/chip_row_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/chip_row_right"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/chip_row_right">

            <com.google.android.material.chip.Chip
                android:id="@+id/profile_type"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:chipMinHeight="20dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="V2Ray" />

            <com.google.android.material.chip.Chip
                android:id="@+id/profile_status"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="4dp"
                android:maxLines="1"
                android:maxWidth="140dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                app:chipBackgroundColor="?attr/colorSurfaceContainerLowest"
                android:ellipsize="end"
                app:chipMinHeight="20dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="123ms" />

        </LinearLayout>

        <!-- Chips row right: Upload + Download (below action icons) -->
        <LinearLayout
            android:id="@+id/chip_row_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/edit">

            <com.google.android.material.chip.Chip
                android:id="@+id/traffic_upload"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:chipMinHeight="20dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="↑ 1.2 MB" />

            <com.google.android.material.chip.Chip
                android:id="@+id/traffic_download"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:chipMinHeight="20dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="↓ 0.8 MB" />

        </LinearLayout>

        <!-- Address row (conditionally visible, bottom of card) -->
        <LinearLayout
            android:id="@+id/address_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_row_left">

            <TextView
                android:id="@+id/profile_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/server_address"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/card_address_text" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
